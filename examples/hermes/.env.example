# Hermes (Radar) — environment variables
# Copy to ~/.hermes/.env and fill in your values

TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_ALLOWED_USERS=YOUR_TELEGRAM_USER_ID,PETER_TELEGRAM_USER_ID

# Discord (optional — remove if not using Discord)
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN
DISCORD_ALLOWED_USERS=YOUR_DISCORD_USER_ID

NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY

# Optional integrations
GEMINI_API_KEY=YOUR_GOOGLE_GEMINI_API_KEY
OPENAI_API_KEY=YOUR_OPENAI_API_KEY          # leave blank to skip OpenAI
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY  # leave blank to skip
GROQ_API_KEY=YOUR_GROQ_API_KEY              # leave blank to skip

# Terminal / browser tool settings
TERMINAL_TIMEOUT=60
TERMINAL_LIFETIME_SECONDS=300
WEB_TOOLS_DEBUG=false

# Hermes internals
HERMES_MAX_ITERATIONS=60
